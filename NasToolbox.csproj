<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NAS 工具箱 - WinUI 3 (.NET 10)
    设备管理 / 网络诊断 / SMB 共享 / 硬盘 SMART / Docker / SSH 终端 / Wake-on-LAN
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NasToolbox</RootNamespace>
    <AssemblyName>NasToolbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- 未指定 RID 时按当前进程架构选择,保证 dotnet run / dotnet publish 可直接用 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- 默认"非打包(Unpackaged)"形态:免 MSIX、解压即用 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 程序集版本(数字四段):1.0.0 -->
    <Version>1.0.0</Version>
    <!-- 界面显示的版本串:启动画面与「关于」页读 InformationalVersion 显示此值 -->
    <InformationalVersion>beta1.0.0</InformationalVersion>
    <!-- 不要把源码提交号追加到 InformationalVersion 后面(否则会显示成 beta1.0.0+<sha>) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 自包含发布:把 .NET 运行时一起带上,目标机无需预装 .NET(此前默认依赖框架,换机就跑不起来) -->
    <SelfContained>true</SelfContained>
    <!-- 永不裁剪:WinUI3 反射依赖多,Trim 不安全 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 只保留简中 / 繁中 / 英文的卫星资源:默认会把 80+ 个语言目录打进包(约 11MB),运行时永远用不到 -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <!-- SSH.NET:必须用新包 ID「SSH.NET」(2026.x,修复 CVE-2026-85756 / CVE-2026-48798);
         旧包 ID「Renci.SshNet」停在 1.0.0,只支持 OpenSSH 8.2 之前的老算法,现代 NAS 上握手会被服务端直接断开 -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- WMI 查询(首页系统摘要) -->
    <PackageReference Include="System.Management" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- 文件选择对话框(System.Windows.Forms.OpenFileDialog):选 SSH 私钥 / 导入镜像 tar -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- img\ 为随附的建议镜像 tar;
       Assets\Terminal\ 为内嵌终端的 xterm.js 离线资源(终端页 WebView2 经虚拟主机加载) -->
  <ItemGroup>
    <Content Include="img\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\Terminal\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinAppSDK 自包含发布会把 80+ 个 WinUI 的 MUI 语言目录(Microsoft.ui.xaml.dll.mui)打进包,
    这些不受 SatelliteResourceLanguages 控制(那是给 .NET 卫星程序集用的)。
    发布后只保留简中 / 繁中 / 英文,其余整目录删除:约省 4MB、目录从 90+ 降到个位数。
  -->
  <Target Name="TrimUnusedLanguageFolders" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;$keep=@('zh-hans','zh-hant','zh-cn','zh-tw','en','en-us','en-gb'); Get-ChildItem -LiteralPath '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Za-z]{2,4})?$' -and ($keep -notcontains $_.Name.ToLower()) } | Remove-Item -Recurse -Force&quot;" />
  </Target>

</Project>