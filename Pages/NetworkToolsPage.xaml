<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.NetworkToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    xmlns:conv="using:NasToolbox.Converters"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- 不用 MaxWidth 居中:ScrollViewer 内容在窗口尺寸变化时居中排版会错乱(内容右移被裁),直接随窗口拉伸 -->
        <StackPanel Padding="24,16" Spacing="12">

            <TextBlock Text="网络诊断" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <!-- 三张卡片单列堆叠:任意窗口宽度下按钮都不会被窗口边缘裁掉 -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Ping -->
            <Border
                x:Name="PingCard"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ping 连通性测试" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <!-- 星号列布局:窗口变窄时输入框自动收缩,按钮不会被遮挡 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PingHostBox" Header="IP / 主机名"
                                 PlaceholderText="默认为选中的 NAS,可修改" HorizontalAlignment="Stretch" />
                        <TextBox x:Name="PingCountBox" Grid.Column="1" Header="次数" Text="4" Width="90"
                                 VerticalAlignment="Bottom" />
                        <Button x:Name="PingBtn" Grid.Column="2" Content="开始 Ping" Style="{StaticResource AccentButtonStyle}"
                                Click="PingBtn_Click" VerticalAlignment="Bottom" />
                        <ProgressRing x:Name="PingRing" Grid.Column="3" Width="20" Height="20" IsActive="True"
                                      Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </Grid>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" MinHeight="60">
                        <TextBlock x:Name="PingOut" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                                   TextWrapping="Wrap" Text="结果将显示在这里" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- NAS 外网诊断(命令在 NAS 上执行,测的是 NAS 自己的外网连通性) -->
            <Border
                x:Name="NasDiagCard"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="NAS 外网诊断" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="命令在 NAS 上通过 SSH 执行,反映 NAS 自身到外部网络的连通性,与本机网络无关。" />
                    <!-- 两行布局:设备独占一行,目标/次数/按钮一行,窄窗口不遮挡 -->
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="NasDiagDeviceBox" Grid.Row="0" Grid.ColumnSpan="4" Header="NAS 设备"
                                  HorizontalAlignment="Stretch"
                                  DisplayMemberPath="DisplayName" />
                        <TextBox x:Name="DiagHostBox" Grid.Row="1" Grid.Column="0" Header="Ping 目标" Text="223.5.5.5"
                                 HorizontalAlignment="Stretch" />
                        <TextBox x:Name="DiagCountBox" Grid.Row="1" Grid.Column="1" Header="次数" Text="4" Width="60"
                                 VerticalAlignment="Bottom" />
                        <Button x:Name="NasPingBtn" Grid.Row="1" Grid.Column="2" Content="连通性测试" Style="{StaticResource AccentButtonStyle}"
                                Click="NasDiagPingBtn_Click" VerticalAlignment="Bottom" />
                        <ProgressRing x:Name="NasDiagRing" Grid.Row="1" Grid.Column="3" Width="20" Height="20" IsActive="True"
                                      Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </Grid>

                    <StackPanel x:Name="NasLossPanel" Spacing="2" Visibility="Collapsed">
                        <TextBlock Text="丢包" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="NasLossValue" FontSize="22" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                    <TextBlock x:Name="NasDiagStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" MinHeight="60">
                        <TextBlock x:Name="NasPingOut" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                                   TextWrapping="Wrap" Text="Ping 原始输出将显示在这里" />
                    </Border>
                </StackPanel>
            </Border>
            </Grid>

            <!-- Speedtest-x 网速测试(基于 Docker) -->
            <Border
                x:Name="SpeedCard"
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="网速测试(Speedtest-x)" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="基于 speedtest-x 的网速测试,需要先在 Docker 部署 speedtest-x。" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SpeedDeviceBox" Header="NAS 设备"
                                  HorizontalAlignment="Stretch"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="SpeedDeviceBox_SelectionChanged" />
                        <Button x:Name="SpeedBtn" Grid.Column="1" Content="开始测速" Style="{StaticResource AccentButtonStyle}"
                                Click="SpeedBtn_Click" VerticalAlignment="Bottom" />
                        <ProgressRing x:Name="SpeedRing" Grid.Column="2" Width="20" Height="20" IsActive="True"
                                      Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- 应用内测速结果:默认展示(无数据时为 0),测速后更新 -->
                    <Grid x:Name="SpeedResults" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="延迟" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Name="PingValue" FontSize="22" FontWeight="SemiBold" Text="0 ms" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="下载" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Name="DownValue" FontSize="22" FontWeight="SemiBold" Text="0 Mbps" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="上传" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Name="UpValue" FontSize="22" FontWeight="SemiBold" Text="0 Mbps" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SpeedIp" FontSize="11" Opacity="0.6" Visibility="Collapsed"
                               TextWrapping="Wrap" Text="" />

                    <!-- 隐藏的 WebView:仅作为网页端测速引擎与数据来源,不在界面中显示 -->
                    <WebView2 x:Name="SpeedWeb" Height="1" Width="1" Opacity="0" IsHitTestVisible="False"
                              NavigationCompleted="SpeedWeb_NavigationCompleted" />

                    <ProgressBar x:Name="SpeedBar" Height="6" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="SpeedStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="" />
                    <HyperlinkButton x:Name="SpeedPageLink" Content="在浏览器打开网页版(可供局域网其他设备测速)"
                                     FontSize="12" Padding="0" Click="OpenSpeedPage_Click" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>