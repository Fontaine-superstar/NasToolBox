<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.AllToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NasToolbox.Models"
    xmlns:conv="using:NasToolbox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="全部工具" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <!-- 工具卡片网格 -->
        <GridView
            x:Name="ToolsGrid"
            Grid.Row="1"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="ToolsGrid_ItemClick">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ToolItem">
                    <Border
                        Width="108" Height="128" CornerRadius="10" Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="{x:Bind ExePath}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Grid Width="52" Height="52" CornerRadius="10"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <!-- 没有提取到图标时,用字体图标占位 -->
                                <FontIcon Glyph="&#xE8B7;" FontSize="24"
                                          Visibility="{x:Bind conv:Conv.WhenEmpty(IconPath)}" />
                                <Image Source="{x:Bind Icon}" Width="34" Height="34" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Width="92" />
                            <TextBlock Text="{x:Bind Category}" FontSize="10" Opacity="0.6"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Width="92" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyHint" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE7B8;" FontSize="36" />
            <TextBlock Text="Tools/ 目录下还没有工具" />
            <TextBlock Text="把 WinSCP、PuTTY 等 NAS 相关绿色工具按分类放入 Tools\分类名\ 子文件夹即可" Opacity="0.6" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>