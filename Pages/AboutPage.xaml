<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16,24,32" Spacing="10" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap">
                NAS 工具箱 -- 基于 WinUI 3 / .NET 10 构建的桌面应用。<LineBreak/>
                令 NAS 用户更加方便使用 NAS 的一款开源软件。
            </TextBlock>

            <TextBlock Text="核心功能" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="13">
                · 设备管理:NAS管理、Web 管理界面、WOL 唤醒、打开 SMB 共享、SSH 终端 / 状态体检 / 命令执行<LineBreak/>
                · 网络诊断:Ping 报告、常用 NAS 端口探测(SSH / SMB / DSM…)、DNS 解析<LineBreak/>
                · 文件管理:经 SMB 浏览 NAS 共享(上传 / 下载 / 拖拽互传),右键可把共享或文件夹映射为本地网络驱动器
            </TextBlock>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,6,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                              Width="20" Height="20" Stretch="Fill"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="项目主页" FontWeight="SemiBold" />
                        <TextBlock Text="https://github.com/Fontaine-superstar/NasToolBox"
                                   FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="项目主页"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" Click="OpenRepoButton_Click" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,6,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="§" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="开源声明 (GPL-3.0)" FontWeight="SemiBold" />
                        <TextBlock Text="许可证义务、无担保条款与数据存放说明"
                                   FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="查看声明"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" Click="ShowNoticeButton_Click" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,6,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Path Data="M896.744632 263.078729c8.860557 5.078103 16.091107 17.553935 16.091106 27.793729v429.653448c0 10.198-7.230549 22.715627-16.091106 27.79373l-129.627449 74.750505c-8.83966 5.078103-16.049312 0.940389-16.049311-9.278508V393.416693c0-10.218898-7.230549-22.715627-16.091107-27.79373l-129.543858-74.813197c-8.860557-5.099-16.070209-0.940389-16.070209 9.257611v106.368484a18.515222 18.515222 0 0 1-18.557017 18.473427H446.172745a18.494324 18.494324 0 0 1-18.494324-18.494324V11.451435c0-10.198 7.209652-14.335713 16.070209-9.257611l48.273321 27.835525c8.860557 5.078103 16.132902 9.215816 16.300082 9.153123 0.125385-0.08359 7.418627 4.075021 16.258287 9.132225l372.185209 214.764032zM427.741114 605.108786c0-10.218898 8.296324-18.494324 18.494324-18.494324h124.632936a18.598812 18.598812 0 0 1 18.577914 18.494324v395.653148c0 10.239795-7.230549 14.356611-16.091107 9.299406l-157.546563-90.987895a612.715909 612.715909 0 0 1-15.986619-9.362098c0-0.062693-7.209652-4.283996-16.091107-9.362098L120.589053 748.382329C111.707598 743.304226 104.497946 730.807497 104.497946 720.567701v-429.653447c0-10.218898 7.209652-22.715627 16.070209-27.79373l129.627448-74.771403c8.860557-5.057205 16.070209-0.919492 16.07021 9.299406v420.437632c0 10.218898 7.209652 22.715627 15.986619 27.79373l129.627448 74.771402c8.860557 5.057205 16.091107 0.919492 16.091107-9.299405l-0.208976-106.263998z"
                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                              Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="作者小黑盒主页" FontWeight="SemiBold" />
                        <TextBlock Text="aaa枫丹大明星"
                                   FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="访问主页"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" Click="OpenXiaoheiheButton_Click" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,6,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Path Data="M7 9.5C7 8.12 8.12 7 9.5 7S12 8.12 12 9.5 10.88 12 9.5 12 7 10.88 7 9.5zm9.5 2.5c1.38 0 2.5-1.12 2.5-2.5S17.88 7 16.5 7 14 8.12 14 9.5s1.12 2.5 2.5 2.5zM7 15.5c0-.17 0-.33.01-.5C5.4 14.99 3.35 15.68 2 17v3h5v-4.5zM9.5 15c-1.61 0-4.9 1.03-6 3v2h12v-2c-1.1-1.97-4.39-3-6-3zm8.99-.01c-.34 0-.67.03-1 .07C18.4 15.85 19 17.08 19 18.5V20h3v-2c0-1.5-2.04-3.01-3.51-3.01zm-1.26 1.87c-.75.24-1.44.6-2.06 1.06-.29.21-.51.53-.63.9-.01.03-.02.06-.03.08-.04.13-.06.26-.06.4V20h5.99v-1.5c0-1.23-1.51-2.33-3.21-2.64zM11.5 14c-2.33 0-7 1.17-7 3.5V19h14v-1.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                              Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="赞赏开发者" FontWeight="SemiBold" />
                        <TextBlock Text="给作者来点Token吧，作者要喂养大肥鱼"
                                   FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="赞赏"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" Click="ShowDonateButton_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>