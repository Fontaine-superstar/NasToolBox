<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="10" MaxWidth="800">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap">
                <Run x:Name="VersionRun" Text="NAS 工具箱" /> —— WinUI 3 / .NET 10 桌面应用。<LineBreak/>
                面向家庭 NAS 场景:设备管理、连通性诊断、Wake-on-LAN 唤醒、SMB 文件管理与网络驱动器映射、硬盘 SMART、Docker 管理。
            </TextBlock>

            <TextBlock Text="核心功能" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="13">
                · 设备管理:NAS 台账(IP / MAC / Web / SSH),一键 Ping、Web 管理、WOL 唤醒、打开 SMB 共享、SSH 终端 / 状态体检 / 命令执行(密码 DPAPI 加密存储)<LineBreak/>
                · 网络诊断:Ping 报告、常用 NAS 端口探测(SSH / SMB / DSM…)、DNS 解析<LineBreak/>
                · 文件管理:经 SMB 浏览 NAS 共享(上传 / 下载 / 拖拽互传),右键可把共享或文件夹映射为本地网络驱动器
            </TextBlock>

            <InfoBar IsOpen="True" Severity="Informational" Title="数据存放"
                     Message="设备列表保存在 %LocalAppData%\NasToolbox\devices.json;设备在线状态在 device_status.json;SSH 主机指纹在 known_hosts.json。" />
            <InfoBar IsOpen="True" Severity="Warning" Title="使用须知"
                     Message="Wake-on-LAN 需要 NAS 的 BIOS/UEFI 与网卡开启相应支持;SMB 匿名枚举被禁用时,请在 Windows 凭据管理器保存该 NAS 地址的 Windows 凭据;NAS 端依赖(curl / smartctl / lsblk 等)缺失时可用设备行的「环境自检」一键补装。" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,6,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                              Fill="{ThemeResource TextFillColorPrimaryBrush}"
                              Width="20" Height="20" Stretch="Fill"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="项目主页" FontWeight="SemiBold" />
                        <TextBlock Text="https://github.com/Fontaine-superstar/NasToolBox"
                                   FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="项目主页"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" Click="OpenRepoButton_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>