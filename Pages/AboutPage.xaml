<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="10" MaxWidth="800">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap">
                NAS 工具箱 v0.2 —— WinUI 3 / .NET 10 桌面应用。<LineBreak/>
                面向家庭 NAS 场景:设备管理、连通性诊断、Wake-on-LAN 唤醒、SMB 共享浏览、磁盘空间概览与第三方绿色工具库。
            </TextBlock>

            <TextBlock Text="核心功能" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="13">
                · 设备管理:NAS 台账(IP / MAC / Web / SSH),一键 Ping、Web 管理、WOL 唤醒、打开 SMB 共享、SSH 终端 / 状态体检 / 命令执行(密码 DPAPI 加密存储)<LineBreak/>
                · 网络诊断:Ping 报告、常用 NAS 端口探测(SSH / SMB / DSM…)、DNS 解析<LineBreak/>
                · 磁盘与共享:本机磁盘空间、枚举并打开远程 SMB 共享<LineBreak/>
                · 工具库:扫描 Tools\ 目录下的绿色工具(WinSCP、PuTTY、FileZilla 等)
            </TextBlock>

            <InfoBar IsOpen="True" Severity="Informational" Title="数据存放"
                     Message="设备列表保存在 %LocalAppData%\NasToolbox\devices.json;工具图标缓存在同目录 IconCache;工具元数据在程序目录 Metadata\tools.json。" />
            <InfoBar IsOpen="True" Severity="Warning" Title="使用须知"
                     Message="Wake-on-LAN 需要 NAS 的 BIOS/UEFI 与网卡开启相应支持;SMB 匿名枚举被禁用时,请先在资源管理器登录 NAS 账号;分发第三方工具前请确认各工具自身授权。" />
            <HyperlinkButton Content="UI 模式参考:TubaWinUi3(github.com/luolangaga/tubatools)"
                             NavigateUri="https://github.com/luolangaga/tubatools" />
        </StackPanel>
    </ScrollViewer>
</Page>