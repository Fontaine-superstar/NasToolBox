<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.NasStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 放宽 SMART 弹窗尺寸:WinUI 的 ContentDialog 默认最大宽 548px,
             属性表有 6 列、概览有 3 列,窄了会把右侧的「通电时间」等列裁掉 -->
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>

        <!-- 分区卡片样式:与设备管理页保持一致 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 分区卡片标题:可点击折叠 / 展开,无按钮外观 -->
        <Style x:Key="CardHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 行内「展开全部 / 收起」文字按钮 -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="NAS 状态" Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" VerticalAlignment="Center"
                              Visibility="Collapsed" IsActive="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DeviceBox" Width="240" Header="设备"
                          DisplayMemberPath="DisplayName" SelectionChanged="DeviceBox_SelectionChanged" />
                <Button Content="刷新" Style="{StaticResource AccentButtonStyle}"
                        Click="RefreshBtn_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12" Opacity="0.7"
                   Margin="0,0,0,10" TextWrapping="Wrap" Text="" />

        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                <!-- ============ 系统 ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="系统" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="2*,1.4*" ColumnSpacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="系统" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="OsText" Style="{StaticResource FieldValue}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="主机名" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="HostnameText" Style="{StaticResource FieldValue}" Text="—" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="CpuModelText" Style="{StaticResource FieldValue}"
                                       Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="GPU" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="GpuText" Style="{StaticResource FieldValue}"
                                       Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="内存" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="SysMemText" Style="{StaticResource FieldValue}"
                                       Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 运行 ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="运行" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="1.2*,1.1*,1.6*" ColumnSpacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="在线状态" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="OnlineText" Style="{StaticResource FieldValue}"
                                           FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="在线时长" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="UptimeText" Style="{StaticResource FieldValue}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="负载(1/5/15 分钟)" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="LoadText" Style="{StaticResource FieldValue}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 内存 ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="内存" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="MemText" FontSize="13" Text="—" />
                        <ProgressBar x:Name="MemBar" Maximum="100" Height="6" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Visibility="Collapsed"
                                   Text="按 /proc/meminfo 的 MemTotal 与 MemAvailable 计算,已用 = 总量 − 可用(含可回收缓存口径)。" />
                    </StackPanel>
                </Border>

                <!-- ============ 硬盘(物理盘) ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <Button Style="{StaticResource CardHeaderButton}" Click="HwToggle_Click" Tag="HwChevron">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="硬盘" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <FontIcon x:Name="HwChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                        </Button>
                        <ListView x:Name="HwList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="HwList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskInfo">
                                    <Grid Margin="0,0,0,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Model}" FontSize="11" Opacity="0.55"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11"
                                                           Opacity="0.45" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind KindText}" FontSize="11" Opacity="0.55" />
                                                <TextBlock Text="|" FontSize="11" Opacity="0.3" />
                                                <TextBlock Text="{x:Bind TranText}" FontSize="11" Opacity="0.55" />
                                                <TextBlock Text="|" FontSize="11" Opacity="0.3" />
                                                <TextBlock Text="{x:Bind HealthText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                           Visibility="{x:Bind OkVisibility}" />
                                                <TextBlock Text="{x:Bind HealthText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                           Visibility="{x:Bind WarnVisibility}" />
                                                <TextBlock Text="{x:Bind HealthText}" FontSize="11" Opacity="0.55"
                                                           Visibility="{x:Bind UnknownVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 右侧箭头:提示这一行可以点开详情页 -->
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="HwHint" Style="{StaticResource FieldHint}"
                                   Text="没有读取到物理硬盘信息(需要 lsblk;健康状态需要 smartmontools)。"
                                   Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource FieldHint}" Opacity="0.55"
                                   Text="点击任意一块硬盘可查看完整 SMART 详情(型号 / 序列号 / 通电时间 / 属性表)。" />
                        <Button x:Name="HwMoreBtn" Style="{StaticResource TextButtonStyle}"
                                HorizontalAlignment="Left" Click="HwToggle_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ============ 网络 ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <Button Style="{StaticResource CardHeaderButton}" Click="NetToggle_Click" Tag="NetChevron">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="网络" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <FontIcon x:Name="NetChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                        </Button>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Text="当前 IP" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="LanIpText" Grid.Column="1" Style="{StaticResource FieldValue}" Text="—" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Text="公网 IP" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="WanIpText" Grid.Column="1" Style="{StaticResource FieldValue}" Text="—" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Text="默认网关" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="GatewayText" Grid.Column="1" Style="{StaticResource FieldValue}" Text="—" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Text="DNS" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="DnsText" Grid.Column="1" Style="{StaticResource FieldValue}" Text="—" />
                        </Grid>
                        <ListView x:Name="NicList" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:NicInfo">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind RateText}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock FontSize="11" Opacity="0.55">
                                            <Run Text="{x:Bind Ipv4}" /> · <Run Text="{x:Bind StateText}" /> · <Run Text="{x:Bind SpeedText}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind TrafficText}" FontSize="11" Opacity="0.55" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="NetMoreBtn" Style="{StaticResource TextButtonStyle}"
                                HorizontalAlignment="Left" Click="NetToggle_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ============ 磁盘空间 ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <Button Style="{StaticResource CardHeaderButton}" Click="DiskToggle_Click" Tag="DiskChevron">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <FontIcon x:Name="DiskChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                        </Button>
                        <ListView x:Name="MountList" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MountUsage">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Mount}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind Filesystem}" FontSize="11" Opacity="0.55" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind UsedText}" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind UsePercentText}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind UsePercent}" Maximum="100" Height="6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="DiskHint" Style="{StaticResource FieldHint}"
                                   Text="没有读取到可展示的挂载点(已跳过 tmpfs / 系统伪文件系统)。"
                                   Visibility="Collapsed" />
                        <Button x:Name="DiskMoreBtn" Style="{StaticResource TextButtonStyle}"
                                HorizontalAlignment="Left" Click="DiskToggle_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="EmptyHint" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE7EF;" FontSize="36" />
            <TextBlock Text="还没有 NAS 设备" HorizontalAlignment="Center" />
            <TextBlock Text="到「设备管理」添加设备并配置 SSH 后,即可在这里查看运行状态" Opacity="0.6"
                       FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ===== 硬盘 SMART 详情 ===== -->
        <ContentDialog x:Name="SmartDialog"
                       Title="SMART 详情"
                       CloseButtonText="关闭"
                       PrimaryButtonText="复制原始输出"
                       PrimaryButtonClick="SmartDialog_PrimaryButtonClick">
            <!-- 内容按可用宽度自适应(属性表 6 列需要 ~640px);下方各处均采用可换行的文本,
                 宽度不足时自动折行而不会横向裁切 -->
            <Grid MaxWidth="900" MinHeight="200" MaxHeight="560">
                <!-- 加载中 -->
                <StackPanel x:Name="SmartLoading" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="22" Height="22" />
                    <TextBlock Text="正在读取 SMART 信息…" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                </StackPanel>

                <!-- 纵向滚动;横向不滚动,宽度由弹窗决定,长值靠 TextWrapping 折行 -->
                <ScrollViewer x:Name="SmartScroll" Visibility="Collapsed"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SmartPanel" Spacing="10" Padding="0,0,12,0" />
                </ScrollViewer>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>