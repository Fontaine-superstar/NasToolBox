<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部:标题 + 设备选择 ===== -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="文件管理" Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" VerticalAlignment="Center"
                              IsActive="True" Visibility="Collapsed" />
            </StackPanel>
            <ComboBox x:Name="DeviceBox" Grid.Column="2" Width="200" Header="NAS 设备"
                      DisplayMemberPath="DisplayName" SelectionChanged="DeviceBox_SelectionChanged" />
            <Button Grid.Column="3" Content="刷新" Style="{StaticResource AccentButtonStyle}"
                    Click="RefreshBtn_Click" VerticalAlignment="Bottom" />
        </Grid>

        <!-- ===== 工具条:路径 + 操作 ===== -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="UpBtn" Content="上一级" Click="UpBtn_Click"
                        VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="回到父目录" />
                <TextBox x:Name="PathBox" Grid.Column="1" Header="当前路径" PlaceholderText="例如 /volume1/docker"
                         KeyDown="PathBox_KeyDown" />
                <Button x:Name="GoBtn" Grid.Column="2" Content="前往" Click="GoBtn_Click"
                        VerticalAlignment="Bottom" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="NewFolderBtn" Content="新建文件夹" Click="NewFolderBtn_Click" />
                <Button x:Name="UploadBtn" Content="上传" Click="UploadBtn_Click"
                        ToolTipService.ToolTip="选择一个或多个本地文件上传到当前目录" />
                <Button x:Name="DownloadBtn" Content="下载" Click="DownloadBtn_Click" IsEnabled="False"
                        ToolTipService.ToolTip="下载选中的文件到本地文件夹" />
                <Button x:Name="DeleteBtn" Content="删除" Click="DeleteBtn_Click" IsEnabled="False"
                        ToolTipService.ToolTip="删除选中的文件或文件夹(文件夹连带内部内容)" />
                <Button x:Name="DriveBtn" Content="网络驱动器" Click="DriveBtn_Click"
                        ToolTipService.ToolTip="管理已映射到此 NAS 的网络驱动器;也可直接右键文件夹快速映射" />
            </StackPanel>
            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Text="支持拖拽:把本地文件拖进列表即上传到当前目录,把列表里的文件拖到资源管理器即下载。右键行可把共享或文件夹映射为本地网络驱动器,映射与断开都在「网络驱动器」里管理。经 SMB(445 端口)访问,登录账号与密码复用该设备的 SSH 账号密码;若 SMB 是另一套账号,请在 Windows 凭据管理器里保存一份该 NAS 地址的 Windows 凭据。" />
        </StackPanel>

        <!-- ===== 文件列表(支持拖拽:拖入上传 / 拖出下载) ===== -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}"
                AllowDrop="True" DragOver="ListCard_DragOver" Drop="ListCard_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 列表头:与数据行的列宽保持一致;名称占大头,其余均分 -->
                <Grid Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="5*" MinWidth="160" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="1.6*" MinWidth="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource ColumnLabel}" />
                    <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource ColumnLabel}" />
                    <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource ColumnLabel}" />
                    <TextBlock Grid.Column="4" Text="修改时间" Style="{StaticResource ColumnLabel}" />
                </Grid>

                <ListView x:Name="FileList" Grid.Row="1" Padding="6,4"
                          SelectionMode="Extended"
                          CanDragItems="True"
                          DoubleTapped="FileList_DoubleTapped"
                          SelectionChanged="FileList_SelectionChanged"
                          RightTapped="FileList_RightTapped"
                          DragItemsStarting="FileList_DragItemsStarting">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <Grid ColumnSpacing="10" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="5*" MinWidth="160" />
                                    <ColumnDefinition Width="*" MinWidth="70" />
                                    <ColumnDefinition Width="*" MinWidth="70" />
                                    <ColumnDefinition Width="1.6*" MinWidth="110" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Opacity="0.75"
                                          HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                           Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind KindText}"
                                           Style="{StaticResource CellText}" FontSize="12" Opacity="0.65" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}"
                                           Style="{StaticResource CellText}" FontSize="12" Opacity="0.65" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText}"
                                           Style="{StaticResource CellText}" FontSize="12" Opacity="0.65" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" x:Name="EmptyHint" Visibility="Collapsed" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" Opacity="0.45" />
                    <TextBlock x:Name="EmptyText" Text="该目录下没有内容" FontSize="13" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 状态 / 传输进度 ===== -->
        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="TransferBar" Height="6" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="" />
        </StackPanel>
    </Grid>
</Page>
