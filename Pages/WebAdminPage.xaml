<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.WebAdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 分区卡片 / 提示样式:本项目约定为逐页复制(见 AI_CONTEXT 约束 10) -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Web 管理" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧:设备侧边栏 ============ -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="CheckBtn" Content="检测" FontSize="12" Padding="10,4"
                                    Click="CheckBtn_Click" ToolTipService.ToolTip="检测全部设备的在线状态" />
                            <Button x:Name="ReloadBtn" Padding="8,5" Click="ReloadBtn_Click"
                                    ToolTipService.ToolTip="重新加载设备列表">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="DeviceList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="DeviceList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceRow">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Device.DisplayName, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Device.Host, Mode=OneWay}" Margin="14,0,0,0"
                                               FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Device.WebOrDefault, Mode=OneWay}" Margin="14,0,0,0"
                                               FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                               Text="在线状态取自上次检测;Web 端口可在「设备管理 → 编辑 → 基本信息」中修改。" />
                </Grid>
            </Border>

            <!-- ============ 右侧:浏览器区 ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具栏:后退 / 前进 / 刷新 / 在系统浏览器打开(不设地址栏,导航统一走左侧设备列表) -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                    <Button x:Name="BackBtn" Padding="8,5" IsEnabled="False" Click="BackBtn_Click"
                            ToolTipService.ToolTip="后退">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button x:Name="ForwardBtn" Padding="8,5" IsEnabled="False" Click="ForwardBtn_Click"
                            ToolTipService.ToolTip="前进">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                    <Button x:Name="WebRefreshBtn" Padding="8,5" Click="WebRefreshBtn_Click"
                            ToolTipService.ToolTip="刷新当前页">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button x:Name="OpenBrowserBtn" Padding="8,5" Click="OpenBrowserBtn_Click"
                            ToolTipService.ToolTip="在系统浏览器打开当前页">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="WebStatus" Grid.Row="1" Style="{StaticResource FieldHint}" Margin="0,0,0,8"
                           Visibility="Collapsed" Text="" />

                <!-- WebView2 + 空态覆盖 -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WebView2 x:Name="AdminWeb"
                                  NavigationStarting="AdminWeb_NavigationStarting"
                                  NavigationCompleted="AdminWeb_NavigationCompleted" />
                        <ProgressBar x:Name="WebProgress" Grid.Row="1" Height="2" IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <StackPanel x:Name="EmptyHint" Grid.RowSpan="2" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="40" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无 NAS 设备" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                                       Text="先在「设备管理」登记 NAS,再回到这里直接打开它的 Web 管理界面。" />
                            <Button Content="去添加设备" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center" Click="GoDevicesBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>