<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏:设备选择 + 连接/断开 + 状态 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" Width="240" Header="NAS 设备" DisplayMemberPath="DisplayName"
                      SelectionChanged="DeviceBox_SelectionChanged" Margin="0,0,12,0" />
            <Button x:Name="ConnectBtn" Grid.Column="1" Content="连接" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" Click="ConnectBtn_Click" Margin="0,0,8,0" />
            <Button x:Name="DisconnectBtn" Grid.Column="2" Content="断开" VerticalAlignment="Bottom"
                    Click="DisconnectBtn_Click" Margin="0,0,8,0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="12" Opacity="0.7"
                       VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="460" TextWrapping="Wrap" />
        </Grid>

        <!-- 终端区:WebView2 内嵌 xterm.js;深色背景固定(与 xterm 主题一致) -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <WebView2 x:Name="TermWeb" WebMessageReceived="TermWeb_WebMessageReceived" />
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE756;" FontSize="40" Foreground="#66FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="选择设备后点击「连接」打开 SSH 终端" Foreground="#DDDDDD"
                               HorizontalAlignment="Center" />
                    <TextBlock FontSize="12" Foreground="#999999" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="支持 vim / top 等全屏程序与彩色输出;需要提权时在终端内执行 sudo -i" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>