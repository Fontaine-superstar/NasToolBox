<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    xmlns:conv="using:NasToolbox.Converters"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 分区卡片:把字段按「基本信息 / SSH 连接 / 权限」分组,替代原先一条平铺长表单 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="NAS 设备管理" Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" VerticalAlignment="Center"
                              Visibility="Collapsed" IsActive="True" />
                <TextBlock x:Name="CurrentHint" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="添加设备" Style="{StaticResource AccentButtonStyle}" Click="AddBtn_Click" />
                <Button Content="全部检测" Click="CheckAllBtn_Click" />
                <Button Content="断开 SSH" Click="DisconnectAllBtn_Click" ToolTipService.ToolTip="清空所有已缓存的 SSH 连接" />
            </StackPanel>
        </Grid>
        <ListView x:Name="DeviceList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DeviceRow">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- x:Bind 默认 OneTime,状态刷新必须显式指定 OneWay -->
                                <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Device.DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Device.Host}" FontSize="11" Opacity="0.65" />
                                    <TextBlock Text="{x:Bind Device.HostnameLine}" FontSize="11" Opacity="0.65"
                                               Visibility="{x:Bind conv:Conv.WhenNotEmpty(Device.HostnameLine)}" />
                                        <TextBlock Text="{x:Bind Device.SshSummary}" FontSize="11" Opacity="0.65" Visibility="{x:Bind conv:Conv.WhenNotEmpty(Device.SshSummary)}" />
                                    <TextBlock Text="{x:Bind Device.Note}" FontSize="11" Opacity="0.65"
                                               Visibility="{x:Bind conv:Conv.WhenNotEmpty(Device.Note)}" />
                                </StackPanel>
                            </Grid>

                            <!-- 状态 + 当前管理复选框:跨两行,整块在卡片右侧垂直居中 -->
                            <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right" Margin="0,0,8,0">
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                           HorizontalAlignment="Center" FontSize="12" />
                                <!-- 勾选后,Docker 等功能页默认管理这台设备 -->
                                <CheckBox Content="当前管理" IsChecked="{x:Bind IsCurrent, Mode=OneWay}"
                                          Click="CurrentBox_Click" MinWidth="0" Margin="0,4,0,0"
                                          HorizontalAlignment="Center"
                                          ToolTipService.ToolTip="勾选后,Docker 等功能页默认操作这台设备(同时只生效一台)" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="20,10,0,0">
                                <Button Content="编辑" Click="EditBtn_Click" FontSize="12" Padding="10,4" />
                                <Button Content="环境自检" Click="DepBtn_Click" FontSize="12" Padding="10,4"
                                        ToolTipService.ToolTip="检查 NAS 上是否装齐 NasToolbox 用到的组件,缺失可一键安装" />
                                <Button Content="删除" Click="DeleteBtn_Click" FontSize="12" Padding="10,4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyHint" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE7B8;" FontSize="36" />
            <TextBlock Text="还没有 NAS 设备" HorizontalAlignment="Center" />
            <TextBlock Text="点击右上角「添加设备」,填入 IP / 主机名即可开始管理" Opacity="0.6" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <ContentDialog
            x:Name="EditDialog"
            Title="NAS 设备"
            PrimaryButtonText="保存"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonClick="EditDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" MinWidth="460" Padding="0,0,14,2">

                    <!-- ============ 基本信息 ============ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" />

                            <Grid ColumnDefinitions="*,*">
                                <TextBox x:Name="HostBox" Header="IP 地址 / 主机名(必填)"
                                         PlaceholderText="192.168.1.10" Margin="0,0,6,0" />
                                <TextBox x:Name="HostnameBox" Grid.Column="1" Header="Hostname(可选)"
                                         PlaceholderText="留空则连接后自动获取" Margin="6,0,0,0"
                                         ToolTipService.ToolTip="填写后即作为设备显示名;留空则在首次连接后自动执行 hostname 回填" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <TextBox x:Name="MacBox" Header="MAC 地址(唤醒用,可留空)"
                                         PlaceholderText="AA:BB:CC:DD:EE:FF" Margin="0,0,6,0" />
                                <NumberBox x:Name="WebPortBox" Grid.Column="1" Header="Web 管理端口(必填)"
                                           Value="5000" Minimum="1" Maximum="65535" SmallChange="1" LargeChange="100"
                                           Margin="6,0,0,0"
                                           GotFocus="WebPortBox_GotFocus" LostFocus="WebPortBox_LostFocus"
                                           ToolTipService.ToolTip="Web 管理页按 http://主机:该端口 打开;常见端口:群晖 5000 · 威联通 8080 · 铁威马 8181 · UnRAID / TrueNAS 80 · OpenWrt 80">
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="Bottom" AllowFocusOnInteraction="False">
                                            <StackPanel MaxWidth="300" Spacing="4">
                                                <TextBlock Text="常见 NAS Web 管理端口" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                                           Text="群晖 5000 · 威联通 8080 · 铁威马 8181 · UnRAID / TrueNAS 80 · OpenWrt 80;Web 管理页按 http://主机:该端口 打开。" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </NumberBox>
                            </Grid>
                            <TextBlock Text="名称不再单独填写:有 Hostname 就用它,没有则显示 IP,连接后会自动补上真实主机名。"
                                       Style="{StaticResource FieldHint}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ SSH 连接 ============ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SSH 连接" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="TestRing" Width="16" Height="16" IsActive="True"
                                                  Visibility="Collapsed" VerticalAlignment="Center" />
                                    <Button x:Name="TestConnBtn" Content="测试连接" Click="TestConnBtn_Click"
                                            FontSize="12" Padding="10,4"
                                            ToolTipService.ToolTip="用下面填写的信息直接连一次,分阶段显示耗时与失败原因" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="110,*">
                                <TextBox x:Name="SshPortBox" Header="SSH 端口" PlaceholderText="22" Margin="0,0,6,0" />
                                <TextBox x:Name="SshUserBox" Grid.Column="1" Header="SSH 用户名"
                                         PlaceholderText="例:admin / root" Margin="6,0,0,0"
                                         TextChanged="SshUserBox_TextChanged" />
                            </Grid>

                            <ComboBox x:Name="SshAuthBox" Header="认证方式" HorizontalAlignment="Stretch"
                                      SelectionChanged="SshAuthBox_SelectionChanged">
                                <ComboBoxItem Content="密码" />
                                <ComboBoxItem Content="私钥文件 (id_rsa / .pem)" />
                            </ComboBox>

                            <!-- 密码认证 -->
                            <PasswordBox x:Name="SshPassBox" Header="SSH 密码"
                                         Description="编辑时留空 = 保持已保存的密码不变" />

                            <!-- 私钥认证 -->
                            <StackPanel x:Name="KeyPanel" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="SshKeyPathBox" Header="私钥文件路径"
                                             PlaceholderText="%USERPROFILE%\.ssh\id_rsa" />
                                    <Button Grid.Column="1" Content="浏览…" Click="BrowseKeyBtn_Click"
                                            VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                </Grid>
                                <PasswordBox x:Name="SshKeyPassBox" Header="私钥口令"
                                             Description="私钥本身未加密则留空" />
                            </StackPanel>

                            <!-- 测试结果:就地展示,不打断填写 -->
                            <InfoBar x:Name="TestResultBar" IsOpen="False" IsClosable="True"
                                     Severity="Informational" />
                        </StackPanel>
                    </Border>

                    <!-- ============ 权限与高级 ============ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="权限与高级" Style="{StaticResource SectionTitle}" />

                            <!-- 三选一互斥模式,杜绝「root 会话 + 关闭 sudo」这类矛盾组合 -->
                            <RadioButtons x:Name="PrivilegeModeBox" Header="权限模式" MaxColumns="1"
                                          SelectionChanged="PrivilegeModeBox_SelectionChanged">
                                <RadioButton>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="普通用户" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="以登录账号身份执行,适合读取类命令" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="sudo 提权" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="每条命令自动加 sudo;smartctl / docker 等命令常需 root" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="root 会话" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="连接后执行 sudo -i,之后所有命令都在 root 会话中;需 sudo 密码,免密 sudo 可留空" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>

                            <PasswordBox x:Name="SudoPassBox" Header="sudo 密码"
                                         Description="留空则在 NAS 上尝试免密 sudo(sudo -n)" />
                            <TextBlock x:Name="RootUserHint" Style="{StaticResource FieldHint}"
                                       Text="当前 SSH 用户已是 root,无需再提权。" Visibility="Collapsed" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                            <NumberBox x:Name="SshTimeoutBox" Header="命令超时(秒)"
                                       Value="20" Minimum="1" Maximum="600"
                                       SmallChange="1" LargeChange="10"
                                       SpinButtonPlacementMode="Compact" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="范围 1–600 秒,默认 20。单条命令超过该时长即中断,慢命令(如 SMART 全盘检测)可调大。" />
                        </StackPanel>
                    </Border>

                    <!-- ============ 其他 ============ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="NoteBox" Header="备注" PlaceholderText="例:4 盘位,RAID5" />
                            <CheckBox x:Name="ClearPassBox" Content="清除已保存的密码 / 私钥口令 / sudo 密码"
                                      ToolTipService.ToolTip="勾选保存后清空本机加密保存的凭据,并移除该主机的指纹记录" />
                        </StackPanel>
                    </Border>

                    <InfoBar x:Name="DialogError" IsOpen="False" Severity="Error" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

    </Grid>
</Page>
