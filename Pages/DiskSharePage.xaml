<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NasToolbox.Pages.DiskSharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NasToolbox.Models"
    xmlns:conv="using:NasToolbox.Converters"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Text="磁盘与共享" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <!-- 本机磁盘 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本机磁盘空间" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="RefreshDrivesBtn" Grid.Column="1" Content="刷新" Click="RefreshDrivesBtn_Click" />
                    </Grid>
                    <ListView x:Name="DrivesList" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveSummary">
                                <Grid Padding="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind conv:Conv.DriveLetter(Root)}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="6" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DisplayText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12"
                                                       Opacity="0.7" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" />
                                        <TextBlock Text="{x:Bind UsedPercentText}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <!-- SMB 共享 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="SMB 共享浏览" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SmbHostBox" Header="NAS 的 IP / 主机名"
                                 PlaceholderText="默认为选中的 NAS,可修改" Width="260" />
                        <Button x:Name="ListBtn" Content="枚举共享" Style="{StaticResource AccentButtonStyle}"
                                Click="ListSharesBtn_Click" VerticalAlignment="Bottom" />
                        <Button Content="直接打开共享根目录" Click="OpenHostBtn_Click" VerticalAlignment="Bottom" />
                        <CheckBox x:Name="ShowHiddenBox" Content="显示隐藏共享($)" VerticalAlignment="Bottom" />
                        <ProgressRing x:Name="SmbRing" Width="20" Height="20" IsActive="True"
                                      Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <InfoBar x:Name="SmbStatus" IsOpen="False" />
                    <ListView x:Name="SharesList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="SharesList_ItemClick" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ShareEntry">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Remark}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="提示:单击列表中的共享将在资源管理器中打开;若提示拒绝访问,请先在资源管理器登录该 NAS 的账号(匿名枚举被禁用时同样适用)。"
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>